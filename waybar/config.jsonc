{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 4,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,

  "modules-left": [
    "custom/power",
    "temperature"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "group/audio",
    "network",
    "bluetooth",
    "tray",
    "clock"
  ],
  
  "clock": {
    "timezone": "Europe/Moscow",
    "format": "{:%H:%M}",
    "format-alt": "{:%d.%m.%Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
		  "mode"             : "year",
		  "mode-mon-col"     : 3,
		  "weeks-pos"        : "right",
		  "first-day-of-week": 1,
		  "on-scroll"        : 1,
		  "on-click-right"   : "mode",
		  "format": {
			  "months":     "<span color='#ffead3'><b>{}</b></span>",
			  "days":       "<span color='#ecc6d9'><b>{}</b></span>",
			  "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
			  "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
			  "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
		  }
	  }
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "persistent-workspaces": {
      "*": 4
    },
    "on-click": "activate",
    "format-icons": {
      "active": "",
      "default": ""
    },
    "sort-by-id": true
  },

  "network": {
    "format-wifi": "{icon}{essid}",
    "format-disconnected": "󰤭 ",
    "format-icons": [
      "󰤯 ",
      "󰤟 ",
      "󰤢 ",
      "󰤥 ",
      "󰤨 "
    ],
    "on-click": "kitty -e nmtui",
    "tooltip": false
  },

  "bluetooth": {
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-on": "",
    "format-connected": "󰂱 ",
    "on-click": "blueman-manager"
  },

  "custom/power": {
    "format": "<span color='#30abfc' size='16000'>  </span>",
    "on-click": "choice=$(printf \"Выключить\\nПерезагрузка\\nВыйти\" | wofi --dmenu -p \"Выберите действие:\"); [ \"$choice\" = \"Выключить\" ] && systemctl poweroff; [ \"$choice\" = \"Перезагрузка\" ] && reboot; [ \"$choice\" = \"Выйти\" ] && loginctl terminate-user $USER",
    "tooltip": false
  },

  "temperature": {
    "thermal-zone": 2,
    "format": "  {temperatureC}°C",
    "warning-format": "<span color='#e6473c'> {temperatureC}°C</span>",
    "critical-format": "<span color='#e6473c'> {temperatureC}°C</span>",
    "warning-threshold": 80,
    "critical-threshold": 95,
    "tooltip": false
  },

  "group/audio": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "not-power",
      "transition-left-to-right": false
    },
    "modules": [
      "pulseaudio",
      "custom/v-",
      "pulseaudio/slider",
      "custom/v+"
    ]
  },

  "custom/v-": {
    "format": "󰝞 ",
    "tooltip": false
  },

  "custom/v+": {
    "format": "󰝝 ",
    "tooltip": false
  },

  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },

  "pulseaudio": {
    "format": "{icon}{volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-icons": [
      "󰕿 ",
      "󰖀 ",
      "󰖀 ",
      "󰕾 "
    ]
  }
}
